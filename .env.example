# API authentication. Generate with: openssl rand -hex 32
TG_SGK_API_KEY=replace-with-a-long-random-key

# Telegram credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_PATH=/data/telegram-user

# Runtime
TG_MOCK=false
TG_SGK_DATA_DIR=/data
TG_SGK_DATABASE_PATH=/data/tg-sgk.sqlite3
TG_SGK_MIN_ACTION_INTERVAL_SECONDS=1.5
TG_SGK_DEFAULT_TIMEOUT_SECONDS=30

# HTTPS reverse proxy. Point this domain to the server.
TG_SGK_DOMAIN=tg.example.com
