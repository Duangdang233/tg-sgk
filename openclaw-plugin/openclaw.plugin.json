{
  "id": "tg-sgk",
  "version": "0.2.1",
  "name": "TG SGK",
  "description": "Direct Telegram user-account automation restricted to bot chats; no Docker sidecar required.",
  "contracts": {
    "tools": [
      "tg_setup_credentials",
      "tg_auth_status",
      "tg_auth_send_code",
      "tg_auth_submit_code",
      "tg_auth_submit_password",
      "tg_bot_inspect",
      "tg_send_message",
      "tg_get_recent_messages",
      "tg_wait_update",
      "tg_click_button",
      "tg_save_flow",
      "tg_list_flows",
      "tg_run_flow",
      "tg_get_history"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiId": {
        "type": "integer",
        "minimum": 1,
        "description": "Telegram api_id from my.telegram.org; optional because tg_setup_credentials can store it later"
      },
      "apiHash": {
        "type": "string",
        "minLength": 8,
        "description": "Telegram api_hash from my.telegram.org; optional because tg_setup_credentials can store it later"
      },
      "phone": {
        "type": "string",
        "minLength": 5,
        "description": "Telegram phone number with country code; optional because tg_setup_credentials can store it later"
      },
      "stateDir": {
        "type": "string",
        "minLength": 1
      },
      "actionIntervalMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60000,
        "default": 1200
      },
      "defaultTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 180000,
        "default": 30000
      }
    }
  }
}
