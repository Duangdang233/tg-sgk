{
  "name": "@duangdang233/openclaw-tg-sgk",
  "version": "0.2.1",
  "description": "Direct Telegram user-account tools for OpenClaw, restricted to bot chats",
  "type": "module",
  "main": "./entry.js",
  "files": [
    "entry.js",
    "index.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "node --check entry.js && node --check index.js",
    "check": "node --check entry.js && node --check index.js",
    "test": "npm run check"
  },
  "dependencies": {
    "teleproto": "1.228.4",
    "typebox": "1.1.39"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./entry.js"
    ],
    "runtimeExtensions": [
      "./entry.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
